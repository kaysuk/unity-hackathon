* text=auto

*.cs text eol=lf
*.py text eol=lf
*.sh text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.json text eol=lf
*.md text eol=lf
*.unity text eol=lf
*.prefab text eol=lf
*.meta text eol=lf

# Initial policy: binary art sources and models. Extend before importing new formats.
*.psd filter=lfs diff=lfs merge=lfs -text
*.psb filter=lfs diff=lfs merge=lfs -text
*.blend filter=lfs diff=lfs merge=lfs -text
*.fbx filter=lfs diff=lfs merge=lfs -text
*.wav filter=lfs diff=lfs merge=lfs -text

# Do not put every .asset file in LFS: many are Unity text assets.
