* text=auto

*.cs text eol=lf
*.py text eol=lf
*.sh text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.json text eol=lf
*.md text eol=lf
*.unity text eol=lf
*.prefab text eol=lf
*.meta text eol=lf

# Initial policy: binary art sources and models. Extend before importing new formats.
*.psd filter=lfs diff=lfs merge=lfs -text
*.psb filter=lfs diff=lfs merge=lfs -text
*.blend filter=lfs diff=lfs merge=lfs -text
*.fbx filter=lfs diff=lfs merge=lfs -text
*.wav filter=lfs diff=lfs merge=lfs -text
*.ogg filter=lfs diff=lfs merge=lfs -text
*.mp3 filter=lfs diff=lfs merge=lfs -text

# Do not put every .asset file in LFS: many are Unity text assets.

# Binary sources and textures from third-party art packs.
Assets/ThirdParty/**/*.bin filter=lfs diff=lfs merge=lfs -text
Assets/ThirdParty/**/*.glb filter=lfs diff=lfs merge=lfs -text
Assets/ThirdParty/**/*.hdr filter=lfs diff=lfs merge=lfs -text
Assets/ThirdParty/**/*.jpg filter=lfs diff=lfs merge=lfs -text
Assets/ThirdParty/**/*.png filter=lfs diff=lfs merge=lfs -text
Assets/ThirdParty/**/*.stl filter=lfs diff=lfs merge=lfs -text

# Arx legacy bitmap textures.
Assets/ThirdParty/Arx/**/*.bmp filter=lfs diff=lfs merge=lfs -text
