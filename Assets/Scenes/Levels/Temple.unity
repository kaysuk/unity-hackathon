  m_Name:
  m_EditorClassIdentifier: Temple.Runtime::TempleDesign.TempleDocument
  prompt: "\u041F\u0440\u043E\u0447\u0435\u0441\u0442\u044C \u0434\u043E\u043A\u0443\u043C\u0435\u043D\u0442 5"
  number: 5
  access: {fileID: 0}
  text: "\u0414\u043E\u043A\u0443\u043C\u0435\u043D\u0442 5 \u0438\u0437 6. \u0417\u043D\u0430\u043A 5: \u043F\u043E\u043B\u0443\u043C\u0435\u0441\u044F\u0446 \u0441 \u0442\u043E\u0447\u043A\u043E\u0439. \u0414\u043B\u044F \u0442\u0430\u0439\u043D\u043E\u0439 \u0441\u0442\u0435\u043D\u044B \u043D\u0430\u0436\u043C\u0438 \u0437\u043D\u0430\u043A\u0438 \u0432 \u043F\u043E\u0440\u044F\u0434\u043A\u0435 \u043D\u043E\u043C\u0435\u0440\u043E\u0432 \u043A\u043E\u043C\u043D\u0430\u0442. \u041D\u0438\u0448\u0430 \u0447\u0435\u0442\u0432\u0451\u0440\u0442\u043E\u0439 \u043A\u043E\u043C\u043D\u0430\u0442\u044B \u043E\u0442\u043A\u0440\u044B\u0432\u0430\u0435\u0442\u0441\u044F \u0442\u0430\u043A: \u0441\u043E\u043B\u043D\u0446\u0435 \u2192 \u0438\u0435\u0440\u043E\u0433\u043B\u0438\u0444."
